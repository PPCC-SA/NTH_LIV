               <ScriptLine />
               <ScriptLine>            ThisForm.Variables("LNum").Value = CStr(CDbl(ThisForm.Variables("LNum").Value) + 1)</ScriptLine>
               <ScriptLine>            FLen = Len(ThisForm.Variables("LPre").Value)</ScriptLine>
               <ScriptLine>            LLen = Len(ThisForm.Variables("LNum").Value)</ScriptLine>
               <ScriptLine>            Select Case ALen - FLen - LLen</ScriptLine>
