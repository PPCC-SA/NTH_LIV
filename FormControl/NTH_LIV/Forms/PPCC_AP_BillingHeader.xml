               <ScriptLine>                           CType(MsgBoxStyle.OkOnly + MsgBoxStyle.Information, MsgBoxStyle), "SyteLine")</ScriptLine>
               <ScriptLine>                Exit Sub</ScriptLine>
               <ScriptLine>            End If</ScriptLine>
               <ScriptLine />
               <ScriptLine>            If ThisForm.Variables("LPre").Value = "" Or ThisForm.Variables("LNum").Value = "" Then</ScriptLine>
               <ScriptLine>                ThisForm.Variables("LPre").Value = ThisForm.Variables("LPrefix").Value</ScriptLine>
               <ScriptLine>                ThisForm.Variables("LNum").Value = ThisForm.Variables("LRunNum").Value</ScriptLine>
