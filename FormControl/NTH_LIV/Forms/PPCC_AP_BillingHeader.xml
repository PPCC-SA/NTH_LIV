               <ScriptLine>                Case 10</ScriptLine>
               <ScriptLine>                    BillNum = ThisForm.Variables("LPre").Value &amp; "0000000000" &amp; ThisForm.Variables("LNum").Value</ScriptLine>
               <ScriptLine>                Case 11</ScriptLine>
               <ScriptLine>                    BillNum = ThisForm.Variables("LPre").Value &amp; "00000000000" &amp; ThisForm.Variables("LNum").Value</ScriptLine>
               <ScriptLine>            End Select</ScriptLine>
               <ScriptLine>            ThisForm.PrimaryIDOCollection.SetCurrentObjectPropertyPlusModifyRefresh("BillNum", BillNum)</ScriptLine>
